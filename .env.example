# BlenderMCPServer — copy to .env and fill in values

# LLM API keys (for LangGraph agents in Phase 2+)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# LLM_PROVIDER: auto | qwen | ollama | gemini | nvidia | gemma | claude
# auto tries NVIDIA NIM first, then Qwen, Gemini, DeepSeek, Claude, Bedrock.
LLM_PROVIDER=auto
QWEEN_MODEL=qwen3:4b
OLLAMA_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://172.31.42.118:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_TIMEOUT_SECONDS=75

# Cloudflare R2 storage
R2_ACCOUNT_ID=e4e93a2fb32f5ec8d4559e62f1f4654a
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=blender-outputs
# Optional: public domain for bucket (leave blank to use presigned URLs)
R2_PUBLIC_URL=

# AWS S3 fallback storage (account 960882269041, region us-east-1).
# Used automatically when an R2 upload fails (e.g. an R2 account-wide outage).
# Leave S3_FALLBACK_BUCKET blank to disable (R2-only, the previous behaviour).
# Mirrors the Rust StorageRouter env contract in src/storage.rs.
S3_FALLBACK_BUCKET=videosync-fallback-960882269041
S3_REGION=us-east-1
# Dedicated long-lived signing key pair. When set, presigned S3 URLs live the
# full R2_PRESIGN_EXPIRY duration; otherwise the default AWS credential chain
# (env / IMDS / task role) is used and URLs expire with the session (~6h).
S3_FALLBACK_ACCESS_KEY_ID=
S3_FALLBACK_SECRET_ACCESS_KEY=

# Shared secret — Rust video_editor and this server must match
MCP_API_KEY=

# Server config
PORT=8000

# Optional: override blender binary path (default: "blender" in PATH)
# BLENDER_BIN=/usr/bin/blender

# Presigned URL expiry in seconds (default: 86400 = 24 hours)
# R2_PRESIGN_EXPIRY=86400
